# ─── LinguaEdu 环境变量配置 ───
# 复制本文件为 .env 并填入你自己的云数据库连接信息

# 云数据库连接字符串（必填）
# ── Neon (推荐，免费 500MB): https://neon.tech
#    格式: postgresql://用户名:密码@ep-xxx.region.aws.neon.tech/数据库名?sslmode=require
#
# ── Supabase (免费 500MB): https://supabase.com
#    格式: postgresql://postgres.项目名:密码@db.区域.supabase.co:5432/postgres
#
# ── Render (免费 PostgreSQL + 部署): https://render.com
#    格式: postgresql://用户:密码@主机:5432/数据库名
#
# ── Railway: https://railway.app
#    格式: postgresql://postgres:密码@主机.railway.app:5432/railway
DATABASE_URL=postgresql://用户名:密码@主机地址:5432/数据库名

# JWT 密钥（生产环境请改为随机字符串）
JWT_SECRET=your-super-secret-jwt-key-change-this

# 服务端口（部署平台会自动注入，本地默认 3000）
PORT=3000
